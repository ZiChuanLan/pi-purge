{
  "name": "pi-purge",
  "version": "0.2.3",
  "description": "opencode v2 plugin: switch a session between opencode's stock system prompt, a trimmed variant, and a bundled or custom persona prompt - for prompt-engineering experiments",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "license": "MIT",
  "author": "ZiChuanLan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiChuanLan/pi-purge.git"
  },
  "homepage": "https://github.com/ZiChuanLan/pi-purge#readme",
  "bugs": {
    "url": "https://github.com/ZiChuanLan/pi-purge/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "system-prompt",
    "prompt-engineering",
    "prompt-evaluation"
  ],
  "files": [
    "index.ts",
    "test",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/purge.test.mjs && node test/purge-env-source.test.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.4 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
